# CI-only builder. The final AppImage does not contain this tool environment.
FROM docker.io/library/ubuntu:22.04@sha256:98510ac07bb4545e389be502a8918b385c018bfe4ceeb5ac7e0375c782268b04
# Freeze the complete dependency closure, not just the top-level apt packages.
# Bootstrap HTTPS from a checksum-pinned Ubuntu package, without running scripts.
# Expired archive timestamps are allowed only for this historical snapshot.
ADD --checksum=sha256:6e8cdcc8c86103acd4fc14649eac62ff2037108389074a7b167567af33c32245 https://snapshot.ubuntu.com/ubuntu/20261020T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~22.04.1_all.deb /tmp/ca-certificates.deb
RUN dpkg-deb --extract /tmp/ca-certificates.deb /tmp/ca-bootstrap \
    && mkdir -p /etc/ssl/certs \
    && cat /tmp/ca-bootstrap/usr/share/ca-certificates/mozilla/*.crt > /etc/ssl/certs/ca-certificates.crt \
    && rm -rf /tmp/ca-bootstrap /tmp/ca-certificates.deb
RUN rm -f /etc/apt/sources.list.d/* && printf '%s\n' \
    'deb [check-valid-until=no] https://snapshot.ubuntu.com/ubuntu/20261020T000000Z jammy main universe' \
    'deb [check-valid-until=no] https://snapshot.ubuntu.com/ubuntu/20261020T000000Z jammy-updates main universe' \
    'deb [check-valid-until=no] https://snapshot.ubuntu.com/ubuntu/20261020T000000Z jammy-security main universe' \
    > /etc/apt/sources.list \
    && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential pkg-config libxkbcommon-dev libwayland-dev libx11-dev \
    libxcb1-dev libvulkan-dev libegl1-mesa-dev ca-certificates python3 python3-pil \
    curl git desktop-file-utils appstream squashfs-tools patchelf zstd dbus-x11 \
    file shellcheck xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY tools.lock.json install-tools.py /opt/ci/
RUN python3 /opt/ci/install-tools.py
ENV PATH=/opt/rust/bin:/opt/ci/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV CARGO_HOME=/work/cargo CARGO_TARGET_DIR=/work/target CARGO_BUILD_JOBS=2 TMPDIR=/work/tmp
# Bound debug/test disk use on standard hosted runners; release settings unchanged.
ENV CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 CARGO_INCREMENTAL=0
# Filesystem-denial, calendar/DST and software layout tests need realistic data.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    tzdata fonts-noto-core fonts-dejavu-core fontconfig \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/work/home
WORKDIR /source
